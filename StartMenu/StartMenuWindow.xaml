<Window x:Class="StudyShell.StartMenu.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="True"
        Width="860" Height="620" MaxHeight="740"
        Deactivated="OnDeactivated" PreviewKeyDown="OnKeyDown">
    <Border x:Name="MenuBorder" CornerRadius="18" Background="#F00A0C14"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#FFF0A94B" BlurRadius="26" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="2,2,2,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE82D;" FontFamily="{DynamicResource IconFont}" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="STUDY SHELL" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="StatusLine" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Grid Width="300" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Padding="38,8" FontSize="13.5" VerticalContentAlignment="Center"
                             ToolTip="Поиск" TextChanged="OnSearchChanged"/>
                </Grid>
            </Grid>

            <!-- Вкладки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="AppsTab" Content="ПРИЛОЖЕНИЯ" Padding="20,8" FontSize="13" FontWeight="SemiBold"
                        Click="OnAppsTab"/>
                <Button x:Name="GamesTab" Content="ИГРЫ" Padding="20,8" FontSize="13" FontWeight="SemiBold"
                        Margin="8,0,0,0" Click="OnGamesTab"/>
            </StackPanel>

            <!-- Приложения -->
            <Grid x:Name="AppsPanel" Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppsItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="120" Height="112" Margin="3" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="{Binding Name}"
                                        Tag="{Binding}" Click="OnAppClick"
                                        MouseRightButtonUp="OnAppRightClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2B"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF222739"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <Image Source="{Binding Icon}" Width="40" Height="40"
                                               HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center"
                                                   TextWrapping="Wrap" MaxHeight="32" Margin="2,8,2,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="AppsEmptyText" Text="Ничего не найдено" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Игры -->
            <Grid x:Name="GamesPanel" Grid.Row="2" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GamesItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="132" Height="186" Margin="6" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="{Binding Name}"
                                        Tag="{Binding}" Click="OnGameClick"
                                        MouseRightButtonUp="OnGameRightClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <Border Height="148" CornerRadius="10" Background="#FF05070D"
                                                BorderBrush="#FF1E2433" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Image x:Name="FallbackIcon" Source="{Binding Icon}" Width="48" Height="48"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Cover, Converter={StaticResource NullToCollapsed}}"/>
                                                <Border Background="#D905070D"
                                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}"
                                                                   FontSize="30" Foreground="#FFFFC233"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="ЗАБЛОКИРОВАНО" FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="#FFFFC233" HorizontalAlignment="Center"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,8,4,0"/>
                                        <TextBlock Text="{Binding Platform}" FontSize="10.5" TextAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="ИГРЫ НЕ НАЙДЕНЫ" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GamesLockNote" Text="" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Button Content="Добавить игру" HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnAddGame"/>
                    <Button Content="Пересканировать" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnRescanGames"/>
                </StackPanel>
            </Grid>

            <!-- Низ -->
            <Grid Grid.Row="3" Margin="2,10,2,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" FontSize="15" Content="&#xE710;" ToolTip="Добавить приложение"
                            Click="OnAddApp"/>
                    <Button Style="{StaticResource IconButton}" FontSize="15" Content="&#xE713;" ToolTip="Параметры"
                            Click="OnOpenSettings"/>
                    <Button Style="{StaticResource IconButton}" FontSize="15" Content="&#xE80F;" ToolTip="Выйти в Windows"
                            Click="OnExitWindows"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PowerBtn" Style="{StaticResource IconButton}" FontSize="16" Content="&#xE7E8;"
                            ToolTip="Питание" Click="OnPowerClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
