<Window x:Class="StudyShell.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neon" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="#FF0A0C14" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Foreground="#FF7E8AA0" FontSize="12" Margin="0,4,0,8"/>
        <TextBox x:Name="ValueBox" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="90" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="ОК" Width="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
