<Window x:Class="StudyShell.Dialogs.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить приложение" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="#FF0A0C14" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="Файл приложения (EXE)" Foreground="#FF7E8AA0" FontSize="12"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" FontSize="13"/>
            <Button Grid.Column="1" Content="Обзор..." Margin="8,0,0,0" Click="OnBrowse"/>
        </Grid>
        <TextBlock Text="Название (необязательно)" Foreground="#FF7E8AA0" FontSize="12" Margin="0,14,0,0"/>
        <TextBox x:Name="NameBox" FontSize="13" Margin="0,6,0,0"/>
        <TextBlock Text="Аргументы запуска (необязательно)" Foreground="#FF7E8AA0" FontSize="12" Margin="0,14,0,0"/>
        <TextBox x:Name="ArgsBox" FontSize="13" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="90" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Добавить" Width="110" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
