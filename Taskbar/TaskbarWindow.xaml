<Window x:Class="StudyShell.Taskbar.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        Background="#E00A0C14" Height="56"
        MouseRightButtonDown="OnTaskbarRightDown"
        Loaded="OnLoaded" Closed="OnClosed">
    <Border x:Name="RootBorder" BorderBrush="#FF1E2433" BorderThickness="0,1,0,0">
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка Neon Start (геймпад) -->
            <Button x:Name="StartButton" Grid.Column="0" Width="46" Height="42" Margin="6,0,2,0"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="OnStartClick" ToolTip="Меню Neon">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF222739"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#xE82D;" FontFamily="{DynamicResource IconFont}" FontSize="21"
                           Foreground="{DynamicResource AccentBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFF0A94B" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Button>

            <!-- Закреплённые -->
            <ItemsControl x:Name="PinnedControl" Grid.Column="1" ItemsSource="{Binding PinnedItems}"
                          VerticalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="44" Height="40" Margin="2,0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="{Binding App.Name}"
                                Click="OnPinnedClick" MouseRightButtonUp="OnPinnedRightClick" Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF222739"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Image Source="{Binding Icon}" Width="26" Height="26"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="2" Width="1" Background="#FF1E2433" Margin="8,12"/>

            <!-- Открытые окна -->
            <ItemsControl x:Name="RunningControl" Grid.Column="3" ItemsSource="{Binding RunningItems}"
                          VerticalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="44" Height="40" Margin="2,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" ToolTip="{Binding Title}"
                                Click="OnRunningClick" MouseRightButtonUp="OnRunningRightClick" Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border Width="18" Height="3" CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"
                                        Margin="0,0,0,-6"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Трей -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="StudyBtn" Style="{StaticResource IconButton}" Width="34" Height="34"
                        FontSize="14" Click="OnStudyClick" ToolTip="Время учёбы" Content="&#xE7EF;"
                        Visibility="Collapsed"/>
                <TextBlock x:Name="StudyTimeText" Text="" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                           Margin="0,0,6,0" Visibility="Collapsed"/>

                <Button x:Name="BatteryBtn" Style="{StaticResource IconButton}" Width="34" Height="34"
                        FontSize="15" Click="OnBatteryClick" ToolTip="Батарея" Visibility="Collapsed"/>
                <Button x:Name="NetworkBtn" Style="{StaticResource IconButton}" Width="34" Height="34"
                        FontSize="15" Click="OnNetworkClick" ToolTip="Сеть" Content="&#xE909;"/>
                <Button x:Name="VolumeBtn" Style="{StaticResource IconButton}" Width="34" Height="34"
                        FontSize="15" Click="OnVolumeClick" ToolTip="Громкость" Content="&#xE767;"/>

                <Button x:Name="ClockBtn" Width="Auto" Height="40" Margin="4,0" Padding="10,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="OnClockClick" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="00:00" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DateText" Text="" Foreground="#FF7E8AA0"
                                   FontSize="10.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ShowDesktopBtn" Width="8" Height="40" Margin="6,0,0,0" Background="Transparent"
                        BorderBrush="#FF1E2433" BorderThickness="1,0,0,0" Cursor="Hand"
                        Click="OnShowDesktop" ToolTip="Показать рабочий стол" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Неоновая линия -->
            <Border x:Name="AccentLine" Grid.ColumnSpan="5" Height="2" Opacity="0.95"
                    Background="{DynamicResource AccentGradientBrush}" VerticalAlignment="Top"/>
        </Grid>
    </Border>
</Window>
