<UserControl x:Class="StudyShell.Desktop.DesktopIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid x:Name="Root">
        <Border x:Name="SelBorder" CornerRadius="9" Background="Transparent"
                BorderBrush="Transparent" BorderThickness="1"/>
        <StackPanel VerticalAlignment="Top">
            <Image x:Name="IconImage" HorizontalAlignment="Center" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="NameText" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="12" Foreground="#FFEAF2FF" Margin="3,5,3,0" MaxHeight="34"
                       LineStackingStrategy="BlockLineHeight" LineHeight="14">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="#FF00E5FF"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
