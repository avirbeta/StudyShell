<Window x:Class="StudyShell.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False"
        Width="368" SizeToContent="Height">
    <Border x:Name="Card" CornerRadius="12" Background="#F512151F"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect Color="#FF00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="40"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="KindBadge" Width="32" Height="32" CornerRadius="16"
                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                <TextBlock x:Name="KindGlyph" Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                <TextBlock x:Name="TitleText" Text="" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Text="" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                    FontSize="9" Content="&#xE711;" VerticalAlignment="Top"
                    Click="OnCloseClick" ToolTip="Закрыть"/>
        </Grid>
    </Border>
</Window>
